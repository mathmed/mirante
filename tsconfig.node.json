// The tooling: CI scripts, their test support (test/support) and the configuration files, run by
// Node.js 24.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["scripts", "test/support", "*.config.ts"]
}
